# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Virtual environment
.venv/

# Runtime save file (per-machine progression)
save.json
save.json.*

# Asset cruft (editor sources / OS metadata) -- the game only loads PNGs
*.aseprite
.DS_Store

# Effect-pack extras -- the game only loads the packed spritesheet.png
assets/effects/*/preview.gif
assets/effects/*/sprites/

# pygbag web-build output (regenerated by web/build.sh)
build/

# Claude Code session data (worktrees, preview config)
.claude/
