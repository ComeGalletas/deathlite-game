# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Coverage output (config is .coveragerc, which is tracked)
.coverage
.coverage.*
htmlcov/

# Virtual environment
.venv/

# Runtime save file (per-machine progression)
save.json
save.json.*

# Asset cruft (editor sources / OS metadata) -- the game only loads PNGs
*.aseprite
.DS_Store

# Effect-pack extras -- the game only loads the packed spritesheet.png
assets/effects/*/preview.gif
assets/effects/*/sprites/

# pygbag web-build output (regenerated by web/build.sh); PyInstaller
# also works under build/pyinstaller and ships to dist/.
build/
dist/
dist_console/

# The reserve art library: packs and spare sprites kept for reference, never
# loaded by the game (`ASSET_DIRS` in desktop/DeathliteGame.spec ships only the
# folders the data names). It was tracked until 2026-09-12 and is not any more
# -- ~300 MB, most of it one 61,783-file effects pack, for art the build never
# touches. Kept out by folder, not by path, so moving it cannot un-ignore it.
assets/unused/
Super Pixel Effects Gigapack/

# Claude Code session data (worktrees, preview config)
.claude/
