# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage output (config is .coveragerc, which is tracked)
.coverage
.coverage.*
htmlcov/

# Virtual environment
.venv/

# Runtime save file (per-machine progression)
save.json
save.json.*

# Asset cruft (editor sources / OS metadata) -- the game only loads PNGs
*.aseprite
.DS_Store
Thumbs.db
desktop.ini

# Effect-pack extras -- the game only loads the packed spritesheet.png. Matched
# at any depth so packs under assets/effects/weapons/<name>/ get the same rule.
assets/effects/**/preview.gif
assets/effects/**/sprites/

# Packaging outputs. Configs live in dist/<target>/ and are tracked; each
# target's generated output beside them is not. build/ is pygbag's hard-coded
# work/output folder (build/web, build/web-cache), copied into dist/web/out/.
build/
dist/desktop/out/
dist/desktop/out-console/
dist/desktop/work/
dist/web/out/

# The reserve art library: packs and spare sprites kept for reference, never
# loaded by the game (`ASSET_DIRS` in dist/desktop/DeathliteGame.spec ships only the
# folders the data names). Untracked since 2026-09-12 -- ~300 MB, most of it the
# 61,783-file effects Gigapack that now lives inside it. The pack is also named
# on its own, matched at any depth, so dragging it back out cannot un-ignore it.
assets/unused/
Super Pixel Effects Gigapack/

# Editors and merge leftovers
.vscode/
.idea/
*.orig
*.rej

# Claude Code session data (worktrees, preview config)
.claude/
