  "imp": {
    "name": "Cinder", "hp": 34, "speed": 86,
    "aggro_range": 480,
    "pursuit_seconds": 6.0, "contact_damage": 10, "radius": 13,
    "weight": 6,
    "experience_reward": 10, "behavior": "path_chase_breath", "color": [214, 104, 58],
    "tags": ["exploder"], "sprite": "imp", "contact_damage_enabled": false,
    "_breath_comment": "Measured off the art, not chosen. In every `attack_loop` frame the flame pool's pixels centre 25.5 world px ahead of the anchor with a half-width of about 17, so radius 13 + `breath_offset` 12 = 25 puts the hazard on the pool and `hazard_radius` sits on it rather than claiming ground the fire never reaches. The first values tried (offset 16, radius 30) put the burn 3.5 px too far out and made it nearly twice the drawn flame; 19 matched the pool's edge. The owner then asked for 35 % less AREA (2026-09-17) -- a percentage on a size means area in this project, not the linear knob -- so the radius scales by sqrt(0.65): 19 -> 15.3, which is 35.2 % less area. The burn now covers 10-40 px ahead and sits a little inside the drawn pool instead of matching its edge, so the fire reads slightly wider than it bites. `hazard_duration` deliberately spans the loop (0.65) AND the embers (0.4), so the damage stops on the last drawn frame rather than while flame is still on screen. No hazard sprite: the imp's own strips draw the fire.",
    "breath_offset": 12, "attack_telegraph": 0.4, "attack_active": 0.65,
    "attack_recover": 0.4, "attack_cooldown": 2.6,
    "hazard_radius": 15.3, "hazard_dps": 16,
    "hazard_duration": 1.05, "hazard_tick": 0.25
  },
